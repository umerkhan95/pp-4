	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "User Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.status === 'success') {",
									"        pm.environment.set('jwt_token', response.token);",
									"        pm.environment.set('device_id', response.user.device_id);",
									"        console.log('JWT Token saved:', response.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"your_password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/login.php",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"login.php"
							]
						},
						"description": "Login with email and password to get JWT token and device information"
					},
					"response": []
				},
