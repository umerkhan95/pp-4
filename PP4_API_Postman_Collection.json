{
	"info": {
		"_postman_id": "pp4-smart-pet-care-api",
		"name": "PP4 Smart Pet Care System API",
		"description": "Complete API collection for PP4 Smart Pet Care System with JWT authentication, device management, scheduling, and pet settings.",
