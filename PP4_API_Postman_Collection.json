	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-refresh JWT token if expired",
					"const tokenTimestamp = pm.environment.get('token_timestamp');",
					"const currentTime = Date.now();",
					"const oneHour = 60 * 60 * 1000; // 1 hour in milliseconds",
					"",
					"if (tokenTimestamp && (currentTime - tokenTimestamp) > oneHour) {",
					"    console.log('JWT token may be expired, consider refreshing');",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global response logging",
					"if (pm.response.code !== 200) {",
					"    console.log('Request failed with status:', pm.response.code);",
					"    console.log('Response:', pm.response.text());",
					"}"
				]
			}
		}
